[Unit]
Description=weibo workspace
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/weibo
ExecStart=/home/ubuntu/leo-project/weibo/.venv/bin/python -m web --port 8774 --public-origin https://d.58nft.net:9452
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
